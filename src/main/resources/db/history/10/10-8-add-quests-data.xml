<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet id="1760099407628-1" author="Ramis">
        <insert tableName="quests">
            <column name="id">1</column>
            <column name="title">
                Нападение пришельцев.
            </column>
            <column name="description">
                Ты проснулся непонятно где, похоже на каком-то инопланетном корабле. Что же делать?
            </column>
            <column name="author_id">1</column>
        </insert>
    </changeSet>

    <changeSet id="1760099901492-1" author="Ramis">
        <insert tableName="questions">
            <column name="id">1</column>
            <column name="description">
                Ты потерял память. Принять вызов НЛО?
            </column>
            <column name="is_end">false</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">2</column>
            <column name="description">
                Ты отклонил вызов. Поражение.
            </column>
            <column name="is_end">true</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">3</column>
            <column name="description">
                Ты принял вызов. Поднимаешься на мостик к капитану?
            </column>
            <column name="is_end">false</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">4</column>
            <column name="description">
                Ты не пошел на переговоры. Поражение.
            </column>
            <column name="is_end">true</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">5</column>
            <column name="description">
                Ты поднялся на мостик. Ты кто?
            </column>
            <column name="is_end">false</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">6</column>
            <column name="description">
                Твою ложь разоблачили. Поражение.
            </column>
            <column name="is_end">true</column>
            <column name="quest_id">1</column>
        </insert>

        <insert tableName="questions">
            <column name="id">7</column>
            <column name="description">
                Тебя вернули домой. Победа.
            </column>
            <column name="is_end">true</column>
            <column name="quest_id">1</column>
        </insert>
    </changeSet>
    <changeSet id="1760100675818-1" author="Ramis">
        <update tableName="quests">
            <column name="first_question_id">1</column>
            <where>id = 1</where>
        </update>
    </changeSet>
</databaseChangeLog>